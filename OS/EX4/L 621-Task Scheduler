#include <stdio.h>
#include <stdlib.h>
#define MAX(a, b) ((a) > (b) ? (a) : (b))
int leastInterval(char* tasks, int tasksSize, int n) {
    int freq[26] = {0};
    for (int i = 0; i < tasksSize; i++) {
        freq[tasks[i] - 'A']++;
    }
    int max_freq = 0;
    for (int i = 0; i < 26; i++) {
        if (freq[i] > max_freq) {
            max_freq = freq[i];
        }
    }
    int max_count = 0;
    for (int i = 0; i < 26; i++) {
        if (freq[i] == max_freq) {
            max_count++;
        }
    }
    int calculated_intervals = (max_freq - 1) * (n + 1) + max_count;
    return MAX(tasksSize, calculated_intervals);
}
